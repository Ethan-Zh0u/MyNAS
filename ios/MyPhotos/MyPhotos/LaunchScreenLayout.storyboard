<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="27000" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="launch-view-controller">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="27000"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="launch-scene">
            <objects>
                <viewController id="launch-view-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="launch-root-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" image="LaunchScreen" translatesAutoresizingMaskIntoConstraints="NO" id="launch-logo-view">
                                <rect key="frame" x="56.5" y="121.5" width="280" height="609"/>
                                <constraints>
                                    <constraint firstAttribute="width" secondItem="launch-logo-view" secondAttribute="height" multiplier="201:437" id="launch-logo-aspect"/>
                                    <constraint firstAttribute="width" constant="280" priority="750" id="launch-logo-preferred-width"/>
                                    <constraint firstAttribute="width" relation="lessThanOrEqual" constant="280" id="launch-logo-max-width"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="launch-safe-area"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <constraints>
                            <constraint firstItem="launch-logo-view" firstAttribute="centerX" secondItem="launch-root-view" secondAttribute="centerX" id="launch-logo-center-x"/>
                            <constraint firstItem="launch-logo-view" firstAttribute="centerY" secondItem="launch-root-view" secondAttribute="centerY" id="launch-logo-center-y"/>
                            <constraint firstItem="launch-logo-view" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="launch-safe-area" secondAttribute="leading" constant="24" id="launch-logo-leading"/>
                            <constraint firstItem="launch-safe-area" firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="launch-logo-view" secondAttribute="trailing" constant="24" id="launch-logo-trailing"/>
                            <constraint firstItem="launch-logo-view" firstAttribute="top" relation="greaterThanOrEqual" secondItem="launch-safe-area" secondAttribute="top" constant="24" id="launch-logo-top"/>
                            <constraint firstItem="launch-safe-area" firstAttribute="bottom" relation="greaterThanOrEqual" secondItem="launch-logo-view" secondAttribute="bottom" constant="24" id="launch-logo-bottom"/>
                        </constraints>
